# Keep this file outside the public web root when possible. Never commit real credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vitalynx
DB_USER=your_database_user
DB_PASS=replace_me

# Set to openai after adding a valid key. If omitted, a configured key enables OpenAI;
# without a key the safe local fallback is used.
AI_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible endpoint override. Leave unset for the official API.
# OPENAI_BASE_URL=https://api.openai.com/v1
